{
  "name": "Enter debug court and leave it on screen for visual inspection",
  "steps": [
    { "action": "reload" },
    { "action": "waitFor", "selector": "[data-testid='lobby-screen']", "timeout": 20000 },
    { "action": "clickIfPresent", "selector": "[data-testid='coach-continue']" },
    { "action": "waitFor", "selector": "[data-testid='dbg-toggle']", "timeout": 8000 },
    { "action": "click", "selector": "[data-testid='dbg-toggle']" },
    { "action": "waitFor", "selector": "[data-testid='debug-input']", "timeout": 5000 },
    { "action": "type", "selector": "[data-testid=debug-input]", "text": "court" },
    { "action": "eval", "expression": "(() => { const el = document.querySelector('[data-testid=debug-input]'); el.dispatchEvent(new KeyboardEvent('keydown', {key:'Enter', bubbles:true})); return 'sent'; })()" },
    { "action": "waitFor", "selector": "[data-testid='game-court']", "timeout": 15000 },
    { "action": "sleep", "ms": 1200 }
  ]
}
