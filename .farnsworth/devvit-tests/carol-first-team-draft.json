{
  "name": "u/carol drafts her first team via PLAY: FTUE → team setup (Cardinals) → 5 picks (rarest of 3) → auto-assign lineup",
  "_note": "Updated to enter via [data-testid='bnav-play'] instead of bnav-draft. bnav-draft always lands on the draft hub (App.jsx onDraft bypasses enterDraftFlow by design) so it never exercised the FTUE router fix (LobbyScreen.handlePlay -> App.enterDraftFlow), which is the exact path that regressed earlier ('clicked Play for the first time -> went straight to the draft screen'). For isFtue + 0 roster + no team, Play now routes straight to teamSelect (.tsetup), skipping the hub entirely - the dh-btn.primary branch below is dead on this path but left in so the test still works if routing ever changes to go through the hub. Draft progress does NOT persist mid-draft (an interrupted run resets roster to 0/5) - must run start-to-finish in ONE run. Keeps bob-first-team-draft's corrected tier map (UNCOMMON:1) rather than the draft-5-picks-rarest version which maps UNCOMMON:0.",
  "steps": [
    {"action": "switchUser", "username": "carol"},
    {"action": "waitFor", "selector": "[data-testid='lobby-screen']", "timeout": 30000},
    {"action": "eval", "expression": "(() => { window.__pickCount = 0; window.__picks = []; return 'reset'; })()"},

    {"action": "while", "max": 5, "until": "!document.querySelector('.lb2-coach')", "steps": [
      {"action": "click", "selector": ".lb2-coach"},
      {"action": "sleep", "ms": 700}
    ]},

    {"action": "extract", "expression": "JSON.stringify({roster: (document.querySelector('[data-testid=roster-strip-empty]') ? 'empty' : 'has-players'), energy: document.querySelector('.lb2-ts-energy')?.textContent?.trim() ?? 'none'})", "into": "preDraft"},

    {"action": "click", "selector": "[data-testid='bnav-play']"},
    {"action": "waitFor", "selector": "[data-testid='ftue-intro-video'], .dh-btn.primary, .tsetup, .draft-start-btn", "timeout": 20000},

    {"action": "if", "condition": "!!document.querySelector(\"[data-testid='ftue-intro-video']\")", "steps": [
      {"action": "click", "selector": "[data-testid='ftue-intro-video']"},
      {"action": "sleep", "ms": 1800},
      {"action": "click", "selector": "[data-testid='ftue-intro-video']"},
      {"action": "sleep", "ms": 600},
      {"action": "click", "selector": "[data-testid='ftue-intro-video']"},
      {"action": "sleep", "ms": 1000}
    ]},

    {"action": "waitFor", "selector": ".dh-btn.primary, .tsetup, .draft-start-btn", "timeout": 20000},
    {"action": "if", "condition": "!!document.querySelector('.dh-btn.primary')", "steps": [
      {"action": "click", "selector": ".dh-btn.primary"},
      {"action": "waitFor", "selector": ".tsetup, .draft-start-btn", "timeout": 15000}
    ]},

    {"action": "extract", "expression": "(() => { const tsetup=!!document.querySelector('.tsetup'); const draft=!!document.querySelector('.draft-start-btn'); return tsetup?'PASS-play-routed-to-teamSetup':(draft?'INFO-already-had-team-went-straight-to-draft':'FAIL-unexpected-scene'); })()", "into": "routingVerdict"},

    {"action": "if", "condition": "!!document.querySelector('.ts-name-input')", "steps": [
      {"action": "type", "selector": ".ts-name-input", "text": "Cardinals"},
      {"action": "click", "selector": "text=CONFIRM"},
      {"action": "sleep", "ms": 900},
      {"action": "clickIfPresent", "selector": "text=CONFIRM"},
      {"action": "sleep", "ms": 900},
      {"action": "clickIfPresent", "selector": "text=CONFIRM"},
      {"action": "sleep", "ms": 900},
      {"action": "clickIfPresent", "selector": "text=CONTINUE TO DRAFT"}
    ]},

    {"action": "waitFor", "selector": ".draft-start-btn", "timeout": 25000},
    {"action": "click", "selector": ".draft-start-btn"},

    {"action": "while", "max": 5, "until": "!document.querySelector('.draft-coach')", "steps": [
      {"action": "click", "selector": ".draft-coach"},
      {"action": "sleep", "ms": 700}
    ]},

    {"action": "while", "max": 14, "until": "window.__pickCount >= 5 || !!document.querySelector('.da-btn.primary.big')", "steps": [
      {"action": "waitFor", "selector": ".draft-coach, .draft-card-slot.phase-back, .draft-card-slot .dc-tier-label, .da-btn.primary.big", "timeout": 40000},

      {"action": "if", "condition": "!document.querySelector('.da-btn.primary.big')", "steps": [
        {"action": "sleep", "ms": 2200, "_comment": "let the round's coach bubble render before we touch anything"},
        {"action": "while", "max": 5, "until": "!document.querySelector('.draft-coach')", "steps": [
          {"action": "click", "selector": ".draft-coach"},
          {"action": "sleep", "ms": 600}
        ]},

        {"action": "while", "max": 6, "until": "!document.querySelector('.draft-card-slot.phase-back')", "steps": [
          {"action": "clickIfPresent", "selector": ".draft-coach"},
          {"action": "click", "selector": ".draft-card-slot:nth-child(1) .draft-card-anim"},
          {"action": "sleep", "ms": 3500}
        ], "_comment": "RETRY the flip until no slot is face-down — a tap eaten by a late coach is invisible otherwise"},

        {"action": "while", "max": 5, "until": "!document.querySelector('.draft-coach')", "steps": [
          {"action": "click", "selector": ".draft-coach"},
          {"action": "sleep", "ms": 600}
        ], "_comment": "post-flip coach"},

        {"action": "waitFor", "selector": ".draft-card-slot .dc-tier-label", "timeout": 25000},
        {"action": "extract", "expression": "(() => { const slots = document.querySelectorAll('.draft-card-slot'); const m = {'COMMON':0,'UNCOMMON':1,'RARE':2,'ULTRA RARE':3}; let best = 1, br = -1; slots.forEach((s, i) => { const l = s.querySelector('.dc-tier-label'); const r = l ? (m[l.textContent.trim()] ?? 0) : 0; if (r > br) { br = r; best = i + 1; } }); window.__pickCount = (window.__pickCount ?? 0) + 1; const c = slots[best-1]; window.__picks.push({rd: window.__pickCount, took: c?.querySelector('.dc-tier-label')?.textContent.trim(), offered: Array.from(slots).map(s=>s.querySelector('.dc-tier-label')?.textContent.trim())}); return best; })()", "into": "bestN"},
        {"action": "click", "selector": ".draft-card-slot:nth-child(${bestN}) .draft-card-anim"},
        {"action": "waitFor", "selector": ".draft-card-anim.picked", "timeout": 12000},
        {"action": "waitForNotVisible", "selector": ".draft-card-anim.picked", "timeout": 40000}
      ]}
    ]},

    {"action": "extract", "expression": "JSON.stringify(window.__picks || [])", "into": "picksMade"},
    {"action": "waitFor", "selector": ".da-btn.primary.big", "timeout": 25000},
    {"action": "clickIfPresent", "selector": "text=AUTO ASSIGN"},
    {"action": "sleep", "ms": 1500},
    {"action": "screenshot", "path": "/tmp/carol-draft-complete.png"},
    {"action": "extract", "expression": "JSON.stringify({primaryLabel: document.querySelector('.da-btn.primary.big')?.textContent.trim(), picks: (window.__picks||[]).length})", "into": "assignState"}
  ]
}

