{
  "name": "zz-ftue-dave-play",
  "description": "As u/dave (expected to be freshly reset), assert the FTUE Play path goes lobby -> TEAM SETUP, not straight to the draft. Reads teamName from user.init first so a stale team name is reported as a precondition failure rather than being mistaken for an App.jsx routing bug. Run bob-reset-dave immediately before this.",
  "steps": [
    { "action": "switchUser", "username": "dave" },
    { "action": "waitFor", "selector": "[data-testid='lobby-screen']", "timeout": 30000 },

    {
      "action": "extract",
      "expression": "(function(){window.__init='pending';fetch('/api/trpc/user.init?batch=1',{method:'GET'}).then(function(r){return r.text();}).then(function(t){window.__init=t.slice(0,900);}).catch(function(e){window.__init='ERR '+e.message;});return 'kicked';})()",
      "into": "kick"
    },
    { "action": "sleep", "ms": 2500 },
    {
      "action": "extract",
      "expression": "(function(){var t=String(window.__init);var tn=t.match(/\"teamName\"\\s*:\\s*(\"[^\"]*\"|null)/);var gp=t.match(/\"gamesPlayed\"\\s*:\\s*(\\d+)/);var un=t.match(/\"username\"\\s*:\\s*\"([^\"]+)\"/);return 'user='+(un?un[1]:'?')+' teamName='+(tn?tn[1]:'ABSENT')+' gamesPlayed='+(gp?gp[1]:'?');})()",
      "into": "serverState"
    },
    {
      "action": "extract",
      "expression": "(function(){var t=String(window.__init);var m=t.match(/\"teamName\"\\s*:\\s*(\"[^\"]*\"|null)/);var v=m?m[1]:'ABSENT';var clean=(v==='null'||v==='\"\"'||v==='\"HOME\"'||v==='ABSENT');return clean?('PRECONDITION-OK-teamName='+v):('PRECONDITION-FAIL-stale-teamName='+v+' (run bob-reset-dave first)');})()",
      "into": "preconditionVerdict"
    },
    {
      "action": "extract",
      "expression": "(function(){var e=document.querySelector('[data-testid=roster-strip-empty]');return e?'roster-empty':'roster-has-players';})()",
      "into": "rosterState"
    },
    { "action": "screenshot", "path": "/tmp/ftue-dave-lobby.png" },

    {
      "action": "while",
      "max": 5,
      "until": "!document.querySelector('.lb2-coach')",
      "steps": [
        { "action": "click", "selector": ".lb2-coach" },
        { "action": "sleep", "ms": 700 }
      ],
      "_comment": "FTUE coach bubble swallows taps on the lobby - dismiss before clicking PLAY."
    },

    { "action": "click", "selector": "[data-testid='bnav-play']" },
    {
      "action": "waitFor",
      "selector": ".tsetup, .draft-screen, .draft-start-overlay, .dh-btn.primary",
      "timeout": 20000,
      "_comment": "Wait for WHICHEVER scene the router lands on - do not presuppose the right one."
    },
    { "action": "sleep", "ms": 800 },
    { "action": "screenshot", "path": "/tmp/ftue-dave-after-play.png" },

    {
      "action": "extract",
      "expression": "(function(){var tsetup=!!document.querySelector('.tsetup');var nameInput=!!document.querySelector('.ts-name-input');var draft=!!document.querySelector('.draft-screen');var hub=!!document.querySelector('.dh-btn.primary');var scene=draft?'draft':(tsetup?'teamSelect':(hub?'draftHub':'unknown'));return JSON.stringify({scene:scene,tsetup:tsetup,nameInput:nameInput,draftScreen:draft,draftHub:hub});})()",
      "into": "landedScene"
    },
    {
      "action": "extract",
      "expression": "(function(){var tsetup=!!document.querySelector('.tsetup');var draft=!!document.querySelector('.draft-screen');if(tsetup&&!draft)return 'PASS-play-goes-to-teamSetup';if(draft)return 'FAIL-play-went-straight-to-draft';return 'FAIL-unexpected-scene';})()",
      "into": "routingVerdict"
    },
    {
      "action": "waitFor",
      "selector": ".ts-name-input",
      "timeout": 8000,
      "_comment": "HARD ASSERT: the team-name field is present and interactive, i.e. a new user is actually asked to name their team."
    },
    {
      "action": "waitForNotVisible",
      "selector": ".draft-screen",
      "timeout": 3000,
      "_comment": "HARD ASSERT: the draft screen is NOT mounted underneath."
    }
  ]
}
