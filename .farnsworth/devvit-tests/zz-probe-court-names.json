{
  "name": "Probe: team name exposure on debug court (short outputs)",
  "steps": [
    {
      "action": "extract",
      "expression": "String(document.body.textContent.toUpperCase().includes('WOLVES'))",
      "into": "tcWolves"
    },
    {
      "action": "extract",
      "expression": "String(document.body.textContent.toUpperCase().includes('HAWKS'))",
      "into": "tcHawks"
    },
    {
      "action": "extract",
      "expression": "String(document.body.innerText.toUpperCase().includes('WOLVES'))",
      "into": "itWolves"
    },
    {
      "action": "extract",
      "expression": "JSON.stringify(Array.from(document.querySelectorAll('svg text')).map(t=>t.textContent.trim()).filter(s=>/[A-Z]{3,}/.test(s)).slice(0,8))",
      "into": "svgWords"
    },
    {
      "action": "extract",
      "expression": "String(!!document.querySelector('[data-testid=game-court]'))",
      "into": "onCourt"
    }
  ]
}
