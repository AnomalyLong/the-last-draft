{
  "name": "zz-verify-roster-record",
  "description": "Opens the Roster screen and reads the lifetime record panel.",
  "steps": [
    { "action": "waitFor", "selector": "[data-testid='lobby-screen']", "timeout": 15000 },
    { "action": "click", "selector": "[data-testid='bnav-collection']" },
    { "action": "waitFor", "selector": "[data-state='collection']", "timeout": 10000 },
    { "action": "waitFor", "selector": "[data-testid='roster-record']", "timeout": 10000 },
    {
      "action": "extract",
      "expression": "JSON.stringify(['wins','losses','winpct','credits'].map(k => document.querySelector('[data-testid=\"roster-record-' + k + '\"]')?.textContent?.trim() ?? 'MISSING'))",
      "into": "record"
    }
  ]
}
